{
	"schemaVersion": 1,
	"id": "ans",
	"version": "${version}",
	"name": "Motion & Bits",
	"description": "Unofficial, private fan-made Java Edition port of the Bedrock resource pack \"Actions & Stuff\" by Oreville Studios (not affiliated or endorsed). Client-side visual mod: re-renders vanilla mobs with animated GeckoLib models. The pack's assets are Oreville Studios' property and are not included in the public source; they are converted locally from your own copy of the pack.",
	"authors": [
		"Komamam39",
		"Original Bedrock pack: Oreville Studios"
	],
	"contact": {
		"homepage": "https://github.com/Komamam39/MotionAndBits",
		"sources": "https://github.com/Komamam39/MotionAndBits",
		"issues": "https://github.com/Komamam39/MotionAndBits/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.ans.client.AnsClient",
			"com.ansviewmodel.AnsViewmodelClient"
		],
		"modmenu": [
			"com.ans.client.settings.AnsModMenu"
		]
	},
	"mixins": [
		{
			"config": "ans.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "ans_viewmodel.mixins.json",
			"environment": "client"
		},
		{
			"config": "ans_perf.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": ">=5.5.5"
	},
	"suggests": {
		"modmenu": "*"
	}
}